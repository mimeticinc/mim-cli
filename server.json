{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.trymimetic/mimetic",
  "title": "Mimetic — Website Growth and Analytics",
  "description": "Website audits, analytics, ads, and A/B test results for finding revenue opportunities.",
  "version": "1.1.0",
  "repository": {
    "url": "https://github.com/mimeticinc/mim-cli",
    "source": "github"
  },
  "websiteUrl": "https://trymimetic.com/docs/mcp",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@mimeticinc/mim-cli",
      "version": "0.4.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MIM_API_TOKEN",
          "description": "Mimetic bearer token. Use secret storage and do not put it in command arguments.",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "MIM_PROJECT",
          "description": "Optional default Mimetic project or site key.",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.trymimetic.com/mcp"
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "documentation": "https://trymimetic.com/docs/mcp",
      "toolCatalog": "https://mcp.trymimetic.com/docs/mcp/tools.json",
      "llmsTxt": "https://mcp.trymimetic.com/llms.txt",
      "categories": [
        "analytics",
        "marketing",
        "ecommerce"
      ],
      "keywords": [
        "conversion optimization",
        "website audit",
        "GA4",
        "Google Ads",
        "Search Console",
        "A/B testing"
      ]
    }
  }
}
